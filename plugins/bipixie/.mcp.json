{
  "mcpServers": {
    "bipixie": {
      "type": "http",
      "url": "https://mcp.bipixie.com/mcp"
    },
    "bipixie-local": {
      "command": "uvx",
      "args": ["bipixie-mcp==0.10.0"],
      "env": {
        "BIPIXIE_MCP_TENANT_ID": "${user_config.tenant_id}",
        "BIPIXIE_MCP_WORKSPACE_NAME": "${user_config.workspace_name}",
        "BIPIXIE_MCP_DATASET_NAME": "${user_config.dataset_name}",
        "BIPIXIE_MCP_AUTH_MODE": "azure_cli",
        "BIPIXIE_MCP_API_APP_ID": "${user_config.api_app_id}"
      }
    }
  }
}
